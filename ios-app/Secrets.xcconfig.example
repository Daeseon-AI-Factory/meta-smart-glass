// Meta Wearables Developer Center 발급 값
// 1. 이 파일을 복사: cp Secrets.xcconfig.example Secrets.xcconfig
// 2. Secrets.xcconfig에 실제 값 입력
// 3. Secrets.xcconfig는 .gitignore에 있어 commit 안 됨

META_APP_ID = YOUR_META_APP_ID_HERE
META_CLIENT_TOKEN = YOUR_CLIENT_TOKEN_HERE
DEVELOPMENT_TEAM = YOUR_APPLE_TEAM_ID_HERE
META_APP_LINK_URL_SCHEME = smartglass
META_UNIVERSAL_LINK_HOST = smartglass.app
